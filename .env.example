# 사내 LiteLLM 프록시 키 (sk-...). 없으면 서버가 목업 면접관으로 동작한다.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://llm.signalplanner.ai
# 역할별 모델 (프록시에 등록된 이름)
REHEARSAL_TURN_MODEL=claude-sonnet-4-6
REHEARSAL_SCENARIO_MODEL=claude-opus-4-8
REHEARSAL_REPORT_MODEL=claude-fable-5
PORT=8787

# 로컬 MySQL / Redis (훈련 기록·예약·시나리오 프리페치). 없으면 해당 기능만 꺼진다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rehearsal
DB_USER=root
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=15

# RabbitMQ (리포트 생성 비동기 처리). 없으면 리포트는 동기 생성.
RABBIT_MQ_PROTOCOL=amqp
RABBIT_MQ_HOST=127.0.0.1
RABBIT_MQ_PORT=5672
RABBIT_MQ_USER=guest
RABBIT_MQ_PASSWORD=guest
RABBIT_MQ_QUEUE=rehearsal_rmq

# 음성 합성. server = 프록시 gpt-4o-mini-tts (권장), browser = 브라우저 내장 음성
REHEARSAL_TTS=server
REHEARSAL_TTS_MODEL=gpt-4o-mini-tts
REHEARSAL_TTS_VOICE=nova

# 관리자 화면(#admin) 비밀번호
REHEARSAL_ADMIN_TOKEN=rehearsal
